# Agreemint - Environment Variables
#
# Copy this file to .env (which is .gitignored) and fill in your values.
# These are passed at build time via --dart-define flags.
#
# For local development:
#   flutter run --dart-define=SUPABASE_URL=<your_url> --dart-define=SUPABASE_ANON_KEY=<your_key>
#
# For CI/CD (GitHub Actions):
#   Add these as Repository Secrets in Settings > Secrets and variables > Actions

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
